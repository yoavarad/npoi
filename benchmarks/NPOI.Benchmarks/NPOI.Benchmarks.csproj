<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <NoWarn>$(NoWarn);SYSLIB0014</NoWarn>
        <SignAssembly>True</SignAssembly>
        <AssemblyOriginatorKeyFile>..\..\npoi.snk</AssemblyOriginatorKeyFile>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="BenchmarkDotNet" />
    </ItemGroup>

    <ItemGroup>
      <ProjectReference Include="..\..\ooxml\NPOI.OOXML.Core.csproj" />
    </ItemGroup>

    <ItemGroup>
      <None Update="data\HugeStyles.xlsx">
        <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      </None>
      <None Update="data\test-performance.xlsx">
        <CopyToOutputDirectory>Always</CopyToOutputDirectory>
      </None>
      <None Update="data\Test1000000x10_SharingStrings.xlsx">
        <CopyToOutputDirectory>Always</CopyToOutputDirectory>
      </None>
      <None Update="data\HugeStyles.xlsx" Condition="Exists('data\HugeStyles.xlsx')">
        <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      </None>
    </ItemGroup>

    <ItemGroup>
      <None Include="../../testcases/test-data/spreadsheet/SimpleWithImages.xls" Link="data/read/SimpleWithImages.xls" CopyToOutputDirectory="PreserveNewest" />
      <None Include="../../testcases/test-data/spreadsheet/Images.xls" Link="data/read/Images.xls" CopyToOutputDirectory="PreserveNewest" />
      <None Include="../../testcases/test-data/spreadsheet/WithEmbeddedObjects.xls" Link="data/read/WithEmbeddedObjects.xls" CopyToOutputDirectory="PreserveNewest" />
      <None Include="../../testcases/test-data/hpsf/TestBug52117.doc" Link="data/read/TestBug52117.doc" CopyToOutputDirectory="PreserveNewest" />
    </ItemGroup>

</Project>
